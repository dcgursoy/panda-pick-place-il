# Heavy artifacts never belong in git (they live under DATA_ROOT, default C:\robodata\panda-pick-place-il).
# Anchored to the repository root: a bare `data/` would also hide the package panda_il/data/.
/data/
/datasets/
/runs/
/videos/
/outputs/
/logs/
/lerobot/
*.zarr/
*.zarr
*.pt
*.pth
*.ckpt
*.safetensors
*.mp4
*.npz
*.parquet
*.log
*.tfevents.*

# The only media that is committed is what the README shows
!docs/figures/**
!docs/gifs/**

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
