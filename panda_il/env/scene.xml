<mujoco model="panda_pick_place">
  <!--
    The table, the cube, the bin, the lights and the fixed cameras. The Franka
    Panda (vendored Menagerie model) is attached at the origin by scene.py, which
    also adds the `tcp` site and the wrist camera to the hand, and orients the
    fixed cameras. Units: metres, radians. The table top is the z = 0 plane.
  -->
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048" offsamples="4"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <map znear="0.01" zfar="20"/>
  </visual>

  <asset>
    <texture name="table_tex" type="2d" builtin="checker" rgb1="0.82 0.82 0.80" rgb2="0.70 0.70 0.68"
             width="256" height="256"/>
    <material name="table_mat" texture="table_tex" texrepeat="8 8" reflectance="0.05"/>
    <material name="floor_mat" rgba="0.45 0.47 0.52 1"/>
    <material name="bin_mat" rgba="0.20 0.35 0.80 1"/>
    <material name="cube_mat" rgba="0.90 0.15 0.10 1"/>
  </asset>

  <worldbody>
    <!-- Shadows are disabled for every light: on this iGPU a shadowed render costs ~44 ms, an unshadowed one ~10 ms. -->
    <light name="key" pos="0.6 -0.6 1.6" dir="-0.25 0.35 -1" castshadow="false" diffuse="0.65 0.65 0.65"/>
    <light name="fill" pos="0.3 0.9 1.3" dir="0.1 -0.6 -1" castshadow="false" diffuse="0.35 0.35 0.35"/>

    <geom name="floor" type="plane" size="3 3 0.1" pos="0 0 -0.76" material="floor_mat"/>
    <!-- 1.2 x 1.2 m table, 5 cm thick, top surface at z = 0; the robot base stands on it at the origin. -->
    <geom name="table" type="box" size="0.6 0.6 0.025" pos="0.3 0 -0.025" material="table_mat"/>

    <!-- 4 cm cube, 50 g. Its start position and yaw are randomised at reset. -->
    <body name="cube" pos="0.5 -0.15 0.02">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.02 0.02 0.02" mass="0.05" material="cube_mat"
            friction="1.0 0.005 0.0001" condim="4"/>
    </body>

    <!-- Open-top bin: inner 12 x 12 cm, floor 5 mm thick, walls 1 cm thick and 6 cm tall. -->
    <body name="bin" pos="0.5 0.25 0">
      <geom name="bin_floor" type="box" size="0.07 0.07 0.0025" pos="0 0 0.0025" material="bin_mat"/>
      <geom name="bin_wall_px" type="box" size="0.005 0.07 0.03" pos="0.065 0 0.03" material="bin_mat"/>
      <geom name="bin_wall_nx" type="box" size="0.005 0.07 0.03" pos="-0.065 0 0.03" material="bin_mat"/>
      <geom name="bin_wall_py" type="box" size="0.07 0.005 0.03" pos="0 0.065 0.03" material="bin_mat"/>
      <geom name="bin_wall_ny" type="box" size="0.07 0.005 0.03" pos="0 -0.065 0.03" material="bin_mat"/>
    </body>

    <!-- Orientations are set by scene.py (look-at), positions here. -->
    <camera name="front" pos="0.98 -0.04 0.84" fovy="48"/>
    <camera name="viewer" pos="1.45 -1.05 0.85" fovy="40"/>
  </worldbody>
</mujoco>
